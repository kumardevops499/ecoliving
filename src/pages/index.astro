
---
import { getCollection } from 'astro:content';

const stories = await getCollection('stories');

stories.sort((a, b) => {
  const dateA = a.data.publication_date ?? '';
  const dateB = b.data.publication_date ?? '';
  return dateB.localeCompare(dateA);
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>EcoLiving Stories</title>
    <meta
      name="description"
      content="Read inspirational stories on EcoLiving Stories."
    />
  </head>

  <body>
    <header>
      <h1>EcoLiving Stories</h1>
      <p>Story publishing prototype</p>
    </header>

    <main>
      <h2>Latest Stories</h2>

      {
        stories.map((story) => (
          <article>
            <h3>
              <a href={`/stories/${story.id}/`}>
                {story.data.title}
              </a>
            </h3>

            <p>{story.data.description}</p>

            <a href={`/stories/${story.id}/`}>
              Read Story →
            </a>
          </article>
        ))
      }

      {stories.length === 0 && <p>No stories published yet.</p>}
    </main>
  </body>
</html>
